# ============================================================================
# Variables de entorno para Supabase
# ============================================================================
# Crea un archivo .env (no commiteado) con estos valores. Los obtienes en:
#   Supabase Dashboard > Project Settings > API
#
# VITE_SUPABASE_URL       → Project URL
# VITE_SUPABASE_ANON_KEY  → anon / public key (segura para el frontend)
#
# IMPORTANTE: nunca pongas la service_role key en el frontend. Solo la anon
# key debe llegar al navegador.
# ============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=